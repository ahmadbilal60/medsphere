/* ═══════════════════════════════════════
   MedSphere — ښکلی ډیزاین
   ═══════════════════════════════════════ */

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'Segoe UI', Tahoma, 'Noto Naskh Arabic', sans-serif;
  background: #f0fdf9;
  color: #1a2b28;
  line-height: 1.9;
  padding-bottom: 60px;
  min-height: 100vh;
}

/* ───── د پورتنۍ پټه ───── */
.topbar {
  background: linear-gradient(135deg, #0a7d6b 0%, #14b8a6 100%);
  color: #fff;
  padding: 18px 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 4px 12px rgba(10, 125, 107, 0.3);
}

.topbar h1 {
  font-size: 22px;
  font-weight: bold;
  letter-spacing: 0.5px;
}

.lang {
  background: rgba(255,255,255,0.2);
  color: #fff;
  border: 1px solid rgba(255,255,255,0.4);
  padding: 6px 16px;
  border-radius: 20px;
  font-weight: bold;
  font-size: 13px;
  cursor: pointer;
  transition: all 0.3s;
}

.lang:hover {
  background: #fff;
  color: #0a7d6b;
  transform: scale(1.05);
}

/* ───── د لټون ځای ───── */
.searchbox {
  padding: 14px 16px 6px;
  background: #f0fdf9;
}

.searchbox input {
  width: 100%;
  padding: 13px 18px;
  border: 2px solid #cfe0dc;
  border-radius: 14px;
  font-size: 15px;
  background: #fff;
  transition: all 0.3s;
  outline: none;
}

.searchbox input:focus {
  border-color: #14b8a6;
  box-shadow: 0 0 0 4px rgba(20, 184, 166, 0.15);
}

/* ───── کټګوري تڼۍ ───── */
.cats {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding: 10px 16px;
  scrollbar-width: none;
}

.cats::-webkit-scrollbar { display: none; }

.cats button {
  white-space: nowrap;
  padding: 8px 18px;
  border: 2px solid #0a7d6b;
  background: #fff;
  color: #0a7d6b;
  border-radius: 22px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s;
}

.cats button:hover {
  background: #e6f7f4;
  transform: translateY(-2px);
}

.cats button.active {
  background: linear-gradient(135deg, #0a7d6b 0%, #14b8a6 100%);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 4px 10px rgba(10, 125, 107, 0.3);
}

/* ───── کارډونه ───── */
.list { padding: 8px 16px; }

.card {
  background: #fff;
  border-radius: 16px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  cursor: pointer;
  transition: all 0.3s;
  border-left: 5px solid #14b8a6;
  position: relative;
  overflow: hidden;
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 60px;
  height: 60px;
  background: radial-gradient(circle, rgba(20,184,166,0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.card:hover {
  transform: translateY(-3px);
  box-shadow: 0 6px 18px rgba(10, 125, 107, 0.15);
  border-left-color: #0a7d6b;
}

.card h3 {
  font-size: 17px;
  color: #0a7d6b;
  margin-bottom: 6px;
  font-weight: bold;
}

.card span {
  font-size: 12px;
  background: linear-gradient(135deg, #e6f7f4 0%, #d1f0eb 100%);
  color: #0a7d6b;
  padding: 3px 12px;
  border-radius: 12px;
  font-weight: 600;
  display: inline-block;
}

.card p {
  font-size: 14px;
  color: #556;
  margin-top: 8px;
  line-height: 1.7;
}

/* ───── د مقالې لوستل ───── */
.reader {
  position: fixed;
  inset: 0;
  background: #f0fdf9;
  overflow-y: auto;
  padding: 16px;
  z-index: 20;
  animation: slideIn 0.3s ease;
}

@keyframes slideIn {
  from { transform: translateX(-100%); opacity: 0; }
  to { transform: translateX(0); opacity: 1; }
}

.reader.hidden { display: none; }

.reader-head button {
  background: linear-gradient(135deg, #0a7d6b 0%, #14b8a6 100%);
  color: #fff;
  border: none;
  font-size: 15px;
  font-weight: bold;
  cursor: pointer;
  padding: 10px 20px;
  border-radius: 12px;
  transition: all 0.3s;
}

.reader-head button:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(10, 125, 107, 0.3);
}

#rTitle {
  color: #0a7d6b;
  margin: 18px 0 16px;
  font-size: 24px;
  font-weight: bold;
  padding-bottom: 12px;
  border-bottom: 3px solid #14b8a6;
}

.reader-body h4 {
  margin: 20px 0 8px;
  color: #0a7d6b;
  font-size: 18px;
  padding-right: 12px;
  border-right: 4px solid #14b8a6;
}

.reader-body p,
.reader-body li {
  font-size: 15px;
  margin-bottom: 8px;
  line-height: 1.9;
}

.reader-body ul {
  padding-inline-start: 24px;
  margin-bottom: 10px;
}

.reader-body li::marker { color: #14b8a6; }

/* ───── خبرداری ───── */
.disclaimer {
  margin-top: 30px;
  padding: 16px;
  background: linear-gradient(135deg, #fff8e6 0%, #fef3c7 100%);
  border-inline-start: 5px solid #f59e0b;
  border-radius: 12px;
  font-size: 13px;
  color: #7a5a00;
  line-height: 1.8;
}

/* ───── ژکړ ───── */
footer {
  text-align: center;
  font-size: 12px;
  color: #889;
  padding: 24px;
  margin-top: 20px;
}

.empty {
  text-align: center;
  color: #889;
  padding: 50px 20px;
  font-size: 15px;
}

/* ───── د کټګوریو رنګونه ───── */
.card[data-cat="داخله"] { border-left-color: #3b82f6; }
.card[data-cat="درمل"] { border-left-color: #f59e0b; }
.card[data-cat="لومړنۍ مرستې"] { border-left-color: #ef4444; }
.card[data-cat="ماشومان"] { border-left-color: #ec4899; }
.card[data-cat="زړه"] { border-left-color: #8b5cf6; }
.card[data-cat="تنفس"] { border-left-color: #06b6d4; }
